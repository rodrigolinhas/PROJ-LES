        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login -> 200\", function () {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const setCookies = pm.response.headers.all()\r",
                  "  .filter(h => h.key.toLowerCase() === \"set-cookie\")\r",
                  "  .map(h => h.value);\r",
                  "\r",
                  "function getCookieValue(name) {\r",
                  "  const row = setCookies.find(v => v.startsWith(name + \"=\"));\r",
                  "  if (!row) return null;\r",
                  "  return row.split(\";\")[0].substring(name.length + 1);\r",
                  "}\r",
                  "\r",
                  "const csrf = getCookieValue(\"csrf_token\");\r",
                  "pm.test(\"CSRF cookie veio no login\", function () {\r",
                  "  pm.expect(csrf).to.not.be.null;\r",
                  "});\r",
                  "\r",
                  "if (csrf) {\r",
                  "  pm.environment.set(\"csrfToken\", csrf);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
