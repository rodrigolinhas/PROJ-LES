                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "  const myEvents = pm.response.json();\r",
                  "\r",
                  "  pm.test(\"My Events -> returns array\", function () {\r",
                  "    pm.expect(myEvents).to.be.an(\"array\");\r",
                  "    pm.expect(myEvents.length).to.be.greaterThan(0);\r",
                  "  });\r",
                  "\r",
                  "  const createdEvent = myEvents.find(\r",
                  "    e => e.Name === pm.environment.get(\"event_name\")\r",
                  "  );\r",
                  "\r",
                  "  pm.test(\"Created event found in my events\", function () {\r",
                  "    pm.expect(createdEvent).to.exist;\r",
                  "  });\r",
                  "\r",
                  "  if (createdEvent) {\r",
                  "    pm.environment.set(\"event_id\", String(createdEvent.ID));\r",
