    {
      "name": "03 - users",
      "item": [
        {
          "name": "users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is JSON response\", () => pm.response.to.be.json);",
                  "",
                  "pm.test(\"Returns array or {users:[...]}\", () => {",
                  "  const data = pm.response.json();",
                  "",
                  "  const list =",
                  "    Array.isArray(data) ? data :",
                  "    Array.isArray(data.users) ? data.users :",
                  "    Array.isArray(data.data) ? data.data :",
                  "    null;",
                  "",
                  "    pm.expect(list, \"did not find a list of users\").to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        }
