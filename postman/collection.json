    {
      "name": "02 - auth",
      "item": [
        {
          "name": "create Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login OK (200)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const bodyText = pm.response.text();",
                  "",
                  "// try JSON first",
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "",
                  "const token =",
                  "  data.token ||",
                  "  data.accessToken ||",
                  "  data.access_token ||",
                  "  data?.data?.token ||",
                  "  null;",
                  "",
                  "pm.test(\"Token exists in awnser\", function () {",
                  "  pm.expect(token, \"token doesnt exist in awnser\").to.not.be.null;",
                  "});",
                  "",
                  "if (token) {",
                  "  pm.environment.set(\"token\", token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - users",
      "item": [
        {
          "name": "users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is JSON response\", () => pm.response.to.be.json);",
                  "",
                  "pm.test(\"Returns array or {users:[...]}\", () => {",
                  "  const data = pm.response.json();",
                  "",
                  "  const list =",
                  "    Array.isArray(data) ? data :",
                  "    Array.isArray(data.users) ? data.users :",
                  "    Array.isArray(data.data) ? data.data :",
                  "    null;",
                  "",
                  "    pm.expect(list, \"did not find a list of users\").to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        }
      ]
