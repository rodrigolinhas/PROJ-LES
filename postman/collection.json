    {
      "name": "03 - auth via sso",
      "item": [
        {
          "name": "SSO_redirect",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"SSO begin -> redirect (302/307)\", function () {\r",
                  "  pm.expect(pm.response.code).to.be.oneOf([302, 307]);\r",
                  "});\r",
                  "\r",
                  "const loc = pm.response.headers.get(\"Location\");\r",
                  "\r",
                  "pm.test(\"Redirect Location header exists\", function () {\r",
                  "  pm.expect(loc).to.be.a(\"string\");\r",
                  "  pm.expect(loc.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Redirect points to Google\", function () {\r",
                  "  pm.expect(loc).to.match(/accounts\\.google\\.com/i);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            }
          },
          "response": []
        },
