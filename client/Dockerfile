# ============================================
# STEP 1: Build
# ============================================
# Use a lightweight Node.js image based on Alpine Linux
FROM node:20-alpine AS builder
WORKDIR /app

# Copy dependency files first, before source code.
# This optimizes Docker cache: dependencies are only reinstalled
# when package.json changes, not on every code change.
COPY package*.json ./
RUN npm install

# Now copy the rest of the source code
# (node_modules and other junk is excluded via .dockerignore)
COPY . .

# Build the application (TypeScript compilation + Vite production bundle)
RUN npm run build

# ============================================
# STEP 2: Web Server (Nginx)
# ============================================
# Nginx is a lightweight web server that serves the static files
# generated by the build step (HTML, CSS, JS).
# We don't need Node.js in production — only a web server.
FROM nginx:alpine

# Override the default Nginx config to support client-side routing.
# Problem: React Router creates virtual routes (e.g. /auth/success) that
# don't exist as real files on disk. Without this, refreshing on those
# routes would return a 404 error.
# Solution: try_files attempts to serve the requested file; if it doesn't
# exist, it falls back to index.html, letting React Router handle the route.
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# Copy the static files generated in step 1 to Nginx's serving directory
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
